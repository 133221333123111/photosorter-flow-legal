<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PhotoSorter</title>
  <meta name="description" content="PhotoSorter legal information, privacy policy, and terms of use.">
  
<style>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --text: #1f2328;
    --muted: #5f6368;
    --link: #0969da;
    --card: #f6f8fa;
    --border: #d0d7de;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117;
      --text: #e6edf3;
      --muted: #8b949e;
      --link: #58a6ff;
      --card: #161b22;
      --border: #30363d;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    line-height: 1.62;
  }
  main {
    width: min(860px, calc(100% - 40px));
    margin: 0 auto;
    padding: 56px 0 72px;
  }
  h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.1; margin: 0 0 14px; }
  h2 { margin-top: 34px; font-size: 1.3rem; }
  p, li { font-size: 1rem; }
  .muted { color: var(--muted); }
  .card {
    margin-top: 28px;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card);
  }
  nav { margin: 18px 0 32px; }
  nav a { margin-right: 18px; }
  a { color: var(--link); text-decoration: none; }
  a:hover { text-decoration: underline; }
  ul { padding-left: 1.35rem; }
  footer {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>

</head>
<body>
<main>
  <h1>PhotoSorter</h1>
  <p class="muted">A privacy-focused Android photo organizer that helps you browse, group, and find visually similar photos.</p>

  <div class="card">
    <h2>Legal</h2>
    <p><a href="privacy.html">Privacy Policy</a></p>
    <p><a href="terms.html">Terms of Use</a></p>
  </div>

  <footer>
    Developed and published by POMF.<br>
    Contact: <a href="mailto:POMF.INTERACTIVE@GMAIL.COM">POMF.INTERACTIVE@GMAIL.COM</a>
  </footer>
</main>
</body>
</html>
